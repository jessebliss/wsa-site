# Copy to .env. Do not commit real values.

# Neon pooled connection string. Example:
# postgresql://USER:PASSWORD@ep-example-pooler.us-east-1.aws.neon.tech/wsa?sslmode=require
# Local Postgres also works for development. The app uses the Neon serverless
# driver when the host contains neon.tech, and node-postgres otherwise.
DATABASE_URL=

# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# The single admin login. Parents do not get accounts.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Stripe test keys until launch. Do not put live keys here yet.
# Live secret keys are rejected unless STRIPE_ALLOW_LIVE=true.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=

# Resend sends receipt email only. No marketing or abandoned-cart mail.
RESEND_API_KEY=
RECEIPT_FROM_EMAIL=

# Public URL used in Stripe return links. Example: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=
