generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SessionKind {
  GROUP
  CAMP
  PRIVATE
}

enum SessionStatus {
  SCHEDULED
  CANCELED
}

enum RepeatKind {
  NONE
  DAILY
  EVERY_N_DAYS
  WEEKLY
  EVERY_N_WEEKS
  MONTHLY_DATE
  MONTHLY_WEEKDAY
  YEARLY
}

enum SeriesEnd {
  NEVER
  ON
  AFTER
}

enum RegistrationKind {
  ONE_TIME
  PLAN_CREDIT
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
  EXPIRED
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
}

enum PaymentMethod {
  STRIPE
  VENMO
}

enum BillingInterval {
  MONTH
  YEAR
}

model Plan {
  id               String         @id @default(cuid())
  seedKey          String?        @unique
  name             String
  program          String
  sessionsPerMonth Int
  priceCents       Int
  billingInterval  BillingInterval @default(MONTH)
  color            String          @default("red")
  stripeProductId  String?
  stripePriceId    String?
  active           Boolean        @default(true)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  subscriptions    Subscription[]

  @@index([active, sortOrder])
  @@map("plans")
}

model EventSeries {
  id              String            @id @default(cuid())
  repeatKind      RepeatKind
  interval        Int               @default(1)
  weekdays        Int[]             @default([])
  monthOrdinal    Int?
  monthWeekday    Int?
  ends            SeriesEnd         @default(NEVER)
  untilDay        String?
  occurrenceCount Int?
  anchorDay       String
  skippedDays     String[]          @default([])
  kind            SessionKind
  program         String
  typeId          String?
  type            TrainingType?     @relation(fields: [typeId], references: [id], onDelete: Restrict)
  title           String
  coach           String?
  coaches         String[]          @default([])
  description     String?
  location        String
  startTime       String
  endTime         String
  capacity        Int
  priceCents      Int
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  sessions        TrainingSession[]

  @@map("event_series")
}

model TrainingSession {
  id              String         @id @default(cuid())
  seedKey         String?        @unique
  kind            SessionKind
  program         String
  typeId          String?
  type            TrainingType?  @relation(fields: [typeId], references: [id], onDelete: Restrict)
  title           String
  coach           String?
  coaches         String[]       @default([])
  description     String?
  location        String
  startsAt        DateTime
  endsAt          DateTime
  capacity        Int
  priceCents      Int
  status          SessionStatus  @default(SCHEDULED)
  seriesId        String?
  series          EventSeries?   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seriesException Boolean        @default(false)
  occurrenceDay   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  registrations   Registration[]

  @@unique([seriesId, occurrenceDay])
  @@index([startsAt])
  @@index([status, startsAt])
  @@index([seriesId])
  @@map("sessions")
}

model Waiver {
  id          String             @id @default(cuid())
  body        String
  isCurrent   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  acceptances WaiverAcceptance[]

  @@index([isCurrent, createdAt])
  @@map("waivers")
}

model WaiverAcceptance {
  id            String         @id @default(cuid())
  fullName      String
  email         String
  acceptedAt    DateTime       @default(now())
  waiverText    String
  waiverId      String?
  waiver        Waiver?        @relation(fields: [waiverId], references: [id])
  registrations Registration[]
  subscriptions Subscription[]

  @@index([email])
  @@map("waiver_acceptances")
}

model Subscription {
  id                   String             @id @default(cuid())
  email                String
  parentName           String
  phone                String
  playerName           String
  planId               String?
  plan                 Plan?              @relation(fields: [planId], references: [id], onDelete: SetNull)
  planName             String             @default("")
  priceCents           Int
  sessionsIncluded     Int
  paymentMethod        PaymentMethod      @default(STRIPE)
  note                 String?
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  sessionsUsed         Int                @default(0)
  waiverAcceptanceId   String?
  waiverAcceptance     WaiverAcceptance?  @relation(fields: [waiverAcceptanceId], references: [id])
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  registrations        Registration[]

  @@index([email])
  @@index([status])
  @@index([planId])
  @@index([createdAt])
  @@map("subscriptions")
}

model Registration {
  id                      String           @id @default(cuid())
  sessionId               String?
  session                 TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product                 String?
  email                   String
  parentName              String
  phone                   String
  playerName              String
  kind                    RegistrationKind
  paymentStatus           PaymentStatus    @default(PENDING)
  amountCents             Int
  registrationCents       Int              @default(0)
  taxCents                Int              @default(0)
  stripeCheckoutSessionId String?          @unique
  stripePaymentIntentId   String?
  promoCodeId             String?
  promoCode               PromoCode?       @relation(fields: [promoCodeId], references: [id])
  subscriptionId          String?
  subscription            Subscription?    @relation(fields: [subscriptionId], references: [id])
  waiverAcceptanceId      String
  waiverAcceptance        WaiverAcceptance @relation(fields: [waiverAcceptanceId], references: [id])
  attended                Boolean?
  holdExpiresAt           DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([sessionId, email])
  @@index([sessionId, paymentStatus])
  @@index([email])
  @@index([createdAt])
  @@index([stripePaymentIntentId])
  @@map("registrations")
}

model CheckoutFee {
  id                     String   @id @default("site")
  registrationFixedCents Int      @default(0)
  registrationBps        Int      @default(0)
  taxFixedCents          Int      @default(0)
  taxBps                 Int      @default(0)
  updatedAt              DateTime @updatedAt

  @@map("checkout_fees")
}

model PromoCode {
  id                    String         @id @default(cuid())
  code                  String         @unique
  percentOff            Int?
  amountOffCents        Int?
  active                Boolean        @default(true)
  stripeCouponId        String?
  stripePromotionCodeId String?
  createdAt             DateTime       @default(now())
  registrations         Registration[]

  @@index([active])
  @@map("promo_codes")
}

model ContactMessage {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  subject   String?
  message   String
  phone     String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
  @@map("contact_messages")
}

model StripeEvent {
  id        String   @id
  createdAt DateTime @default(now())

  @@map("stripe_events")
}

model CoachPrice {
  coachName               String   @id
  privateQuarterbackCents Int?
  speedCents              Int?
  updatedAt               DateTime @updatedAt

  @@map("coach_prices")
}

model RetiredCoach {
  id        String   @id @default(cuid())
  coachName String   @unique
  createdAt DateTime @default(now())

  @@map("retired_coaches")
}

model StaffUser {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  coachName    String     @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  days         CoachDay[]

  @@map("staff_users")
}

model TrainingType {
  id           String            @id @default(cuid())
  name         String            @unique
  description  String            @default("")
  nextStep     String            @default("Choose a coach")
  offeringKey  String?           @unique
  colorProgram String            @default("")
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sessions     TrainingSession[]
  series       EventSeries[]

  @@map("training_types")
}

model CoachDay {
  id          String    @id @default(cuid())
  staffUserId String
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  dayKey      String
  unavailable Boolean   @default(false)
  hours       Int[]     @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([staffUserId, dayKey])
  @@index([dayKey])
  @@map("coach_days")
}
